        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De betaling wordt in rekening gebracht via je Apple ID. Abonnementen verlengen automatisch tot je ze minstens 24 uur voor het einde van de periode opzegt in Instellingen."
