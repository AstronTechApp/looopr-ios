    "profile.deleteFailedMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Spaziergang wurde von diesem Gerät entfernt, aber der Server war nicht erreichbar. Er kann wieder auftauchen, wenn deine anderen Geräte synchronisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The walk was removed from this device, but we couldn't reach the server. It may reappear when your other devices sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El paseo se eliminó de este dispositivo, pero no pudimos conectar con el servidor. Puede reaparecer cuando tus otros dispositivos se sincronicen."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El paseo se eliminó de este dispositivo, pero no pudimos conectar con el servidor. Puede reaparecer cuando tus otros dispositivos se sincronicen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La balade a été supprimée de cet appareil, mais le serveur était injoignable. Elle peut réapparaître lors de la synchronisation de vos autres appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La passeggiata è stata rimossa da questo dispositivo, ma non siamo riusciti a raggiungere il server. Potrebbe riapparire quando gli altri dispositivi si sincronizzano."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De wandeling is van dit apparaat verwijderd, maar we konden de server niet bereiken. Mogelijk verschijnt hij weer als je andere apparaten synchroniseren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A caminhada foi removida deste dispositivo, mas não conseguimos acessar o servidor. Ela pode reaparecer quando seus outros dispositivos sincronizarem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A caminhada foi removida deste dispositivo, mas não conseguimos aceder ao servidor. Pode reaparecer quando os seus outros dispositivos sincronizarem."
          }
        }
      }
    },
